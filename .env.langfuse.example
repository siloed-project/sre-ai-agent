# Postgres
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=langfuse
DATABASE_URL=postgresql://langfuse:change-me@langfuse-db:5432/langfuse

# LangFuse auth
NEXTAUTH_URL=https://sre-agent.siloed.dev
NEXTAUTH_SECRET=change-me-32-char-random-string
SALT=change-me-16-char-random-string
ENCRYPTION_KEY=change-me-64-char-hex-string
# OIDC provider used by Cloudflare Access (VPS deployment). Uncomment and fill in.
# AUTH_CUSTOM_CLIENT_ID=change-me-oidc-client-id
# AUTH_CUSTOM_CLIENT_SECRET=change-me-oidc-client-secret
# AUTH_CUSTOM_ISSUER=https://idp.example.com
# AUTH_CUSTOM_NAME=Company SSO
# AUTH_CUSTOM_ALLOW_ACCOUNT_LINKING=true
# AUTH_DISABLE_USERNAME_PASSWORD=true
# AUTH_DISABLE_SIGNUP=true

# ClickHouse
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_CLUSTER_ENABLED=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_AUTH=change-me

# MinIO (S3-compatible local storage)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=auto
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=change-me
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_REGION=auto
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=change-me
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=media/
LANGFUSE_S3_BATCH_EXPORT_ENABLED=false

# Bootstrap a default org/project/user on first start (avoids manual signup)
LANGFUSE_INIT_ORG_ID=my-org
LANGFUSE_INIT_ORG_NAME=SRE Agent
LANGFUSE_INIT_PROJECT_ID=my-project
LANGFUSE_INIT_PROJECT_NAME=sre-agent
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=change-me-public-key
LANGFUSE_INIT_PROJECT_SECRET_KEY=change-me-secret-key
LANGFUSE_INIT_USER_EMAIL=change-me@example.com
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=change-me
