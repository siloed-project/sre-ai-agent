[Unit]
Description=LangFuse (docker compose)
Documentation=https://langfuse.com/docs/deployment/self-host
After=docker.service network-online.target
Requires=docker.service

[Service]
WorkingDirectory=/opt/sre-agent
EnvironmentFile=/etc/sre-agent/langfuse.env
Environment=LANGFUSE_ENV_FILE=/etc/sre-agent/langfuse.env
ExecStartPre=/usr/bin/docker compose -f docker-compose.langfuse.yml pull
ExecStart=docker compose -f docker-compose.langfuse.yml up
ExecStop=docker compose -f docker-compose.langfuse.yml down
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
