[Unit]
Description=SRE Agent Dashboard Auth Server
After=network.target

[Service]
User=sre-agent
EnvironmentFile=/etc/sre-agent/dashboard.env
WorkingDirectory=/opt/sre-agent
ExecStart=/opt/sre-agent/.venv/bin/python scripts/auth_server.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
