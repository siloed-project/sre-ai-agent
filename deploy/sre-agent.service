[Unit]
Description=SRE AI Telegram Bot
# sre-agent-cloudflared-kube.service is optional (see README "Private
# kube-apiserver access"). Wants= on a unit that was never installed is a
# no-op -- systemd skips it silently, this still starts fine without it.
After=network.target sre-agent-cloudflared-kube.service
Wants=sre-agent-cloudflared-kube.service

[Service]
User=sre-agent
EnvironmentFile=/etc/sre-agent/env
WorkingDirectory=/opt/sre-agent
ExecStart=/opt/sre-agent/.venv/bin/python -m app.telegram_bot
Restart=always
RestartSec=10
StartLimitIntervalSec=60
StartLimitBurst=3
TimeoutStopSec=15
StateDirectory=sre-agent
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
