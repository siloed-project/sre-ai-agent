{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["existingSecret"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1, "maximum": 1},
    "existingSecret": {"type": "string", "minLength": 1},
    "langfuse": {
      "type": "object",
      "required": ["enabled", "host", "existingSecret", "publicKeyKey", "secretKeyKey"],
      "properties": {
        "enabled": {"type": "boolean"},
        "host": {"type": "string"},
        "existingSecret": {"type": "string"},
        "publicKeyKey": {"type": "string", "minLength": 1},
        "secretKeyKey": {"type": "string", "minLength": 1}
      },
      "if": {
        "properties": {"enabled": {"const": true}}
      },
      "then": {
        "properties": {
          "host": {"minLength": 1},
          "existingSecret": {"minLength": 1}
        }
      }
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "existingClaim": {"type": "string"},
        "storageClass": {"type": "string"},
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "size": {"type": "string", "minLength": 1}
      }
    }
  }
}
