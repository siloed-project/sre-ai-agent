ANTHROPIC_API_KEY=your-key-here

# kubeconfig is the default for local CLI and VPS deployments. Helm sets this
# to in_cluster automatically so the pod uses its ServiceAccount token.
# KUBERNETES_ACCESS_MODE=kubeconfig

# Path for conversation memory SQLite DB (default: memory.db in working directory)
# To use the /var/lib convention, first create the directory manually:
#   sudo mkdir -p /var/lib/sre-agent && sudo chown sre-agent:sre-agent /var/lib/sre-agent
# MEMORY_DB_PATH=/var/lib/sre-agent/memory.db

# LangFuse tracing (optional — omit to disable)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://sre-agent.siloed.dev
